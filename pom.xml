<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Sửa code mục 3.3 "Xử lý một CVE", Bài 02 Giai đoạn 6: Trivy báo CVE-2026-22731, CVE-2026-22733
             (actuator, vá ở 3.5.12) -> nâng bản patch Spring Boot thay vì ghi đè từng thư viện -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>wallet-service</artifactId>
    <!-- Sửa bài tập 1 (Dễ) - mục 10 "Bài tập tự làm", Bài 03 Giai đoạn 0: release 0.0.3 (thêm GET /api/accounts) -->
    <!-- Sửa code Bước 3 - mục 6 "Thực hành từng bước", Bài 01 Giai đoạn 6: đổi version để SonarQube tạo mốc
         New Code = Previous version (code thay đổi kể từ lần phân tích 0.0.3) -->
    <version>0.0.4</version>
    <name>wallet-service</name>
    <description>Vi dien tu mau cho lo trinh CI/CD</description>

    <properties>
        <java.version>21</java.version>
        <!-- Thêm code mục 9 "Lỗi thường gặp", Bài 03 Giai đoạn 3: bản 1.21.3 mặc định dùng Docker API quá cũ,
             Docker Engine 29+ trả 400 "Could not find a valid Docker environment" -> nâng lên 1.21.x mới nhất -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Sửa code mục 3.3 "Xử lý một CVE", Bài 02 Giai đoạn 6: Spring Boot 3.5.16 vẫn quản lý pgjdbc 42.7.11,
             còn CVE-2026-54291 (vá ở 42.7.12) -> ghi đè lên 42.7.13 (bản Spring Boot 4.0.x đang dùng).
             Bỏ dòng này khi Spring Boot quản lý >= 42.7.12 -->
        <postgresql.version>42.7.13</postgresql.version>
        <!-- Sửa code mục 9 "Lỗi thường gặp", Bài 03 Giai đoạn 6: Trivy image chặn CVE trong thư viện bắc cầu mà
             Spring Boot 3.5.16 chưa nâng -> ghi đè bản patch cùng dòng (bài tập 2, Bài 02):
             tomcat 10.1.55 -> 10.1.61 (CVE-2026-65182, -65905, -68525 CRITICAL, vá ở 10.1.58);
             jackson 2.21.4 -> 2.21.8 (CVE-2026-68497, -89407, -89425, -91776, -91777 HIGH, vá ở 2.21.7).
             Bỏ 2 dòng này khi Spring Boot quản lý phiên bản >= bản vá -->
        <tomcat.version>10.1.61</tomcat.version>
        <jackson-bom.version>2.21.8</jackson-bom.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Thêm code Bước 1 - mục 6 "Thực hành từng bước", Bài 03 Giai đoạn 3: JPA + PostgreSQL -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Thêm code Bước 1 - mục 6 "Thực hành từng bước", Bài 03 Giai đoạn 4: Flyway quản lý schema bằng migration -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Thêm code Bước 1 - mục 6 "Thực hành từng bước", Bài 03 Giai đoạn 3: Testcontainers chạy PostgreSQL thật khi test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!-- Thêm code Bước 5 - mục 6 "Thực hành từng bước", Bài 08 Giai đoạn 1:
                 failsafe chạy integration test (*IT.java) ở phase integration-test/verify -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <!-- Thêm code Bước 1 - mục 6 "Thực hành từng bước", Bài 01 Giai đoạn 6:
                 JaCoCo đo coverage unit (surefire) + IT (failsafe); verify fail nếu LINE < 70% hoặc BRANCH < 60% -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.70</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.60</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Thêm code Bước 5 - mục 6 "Thực hành từng bước", Bài 08 Giai đoạn 1:
                 enforcer chặn build sai môi trường (Java >= 21, Maven >= 3.9, không xung đột phiên bản thư viện) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-environment</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Thêm code Bước 1 - mục 6 "Thực hành từng bước", Bài 03 Giai đoạn 6: SBOM CycloneDX của ứng dụng.
                 Version + execution do spring-boot-starter-parent quản lý: tạo META-INF/sbom/application.cdx.json
                 ở phase generate-resources và Spring Boot đóng file này vào jar -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
